# CDSCO Application Environment Configuration

# Project Metadata
PROJECT_NAME="CDSCO Medical Device Dossier Builder"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS Allowed Origins (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Database Connection (PostgreSQL 15+)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cdsco_dossier
# Optional explicit override (e.g. postgresql+asyncpg://user:pass@localhost:5432/cdsco_dossier)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cdsco_dossier

# Storage and Thresholds
STORAGE_DIR=./storage
MAX_FILE_SIZE_BYTES=10485760
